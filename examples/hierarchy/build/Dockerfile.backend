FROM acme/nodejs:20.0.0

# Common labels
LABEL image.name="backend"
LABEL image.parent="nodejs"
LABEL image.version="1.0.0"
LABEL layer="app"
LABEL project="hierarchy-example"

# Build arguments - including platform info
ARG TARGETPLATFORM
ARG TARGETOS
ARG TARGETARCH
ARG BUILDPLATFORM

# Environment variables
ENV PORT=8080

# Backend app: FROM nodejs (inherits the Node runtime). Express-style API.
EXPOSE ${PORT}
CMD ["sh", "-c", "node -e \"require('http').createServer((_,r)=>r.end('ok')).listen(${PORT})\""]




