FROM acme/ubuntu:22.04.0

# Common labels
LABEL image.name="nodejs"
LABEL image.parent="ubuntu"
LABEL image.version="20.0.0"
LABEL layer="runtime"
LABEL project="hierarchy-example"

# Build arguments - including platform info
ARG TARGETPLATFORM
ARG TARGETOS
ARG TARGETARCH
ARG BUILDPLATFORM
ARG NODE_VERSION=20

# Node runtime layer: FROM ubuntu (resolved automatically to the parent image),
# installs Node ${NODE_VERSION} on top of the shared base.
RUN curl -fsSL "https://deb.nodesource.com/setup_${NODE_VERSION}.x" | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/*
RUN node --version




