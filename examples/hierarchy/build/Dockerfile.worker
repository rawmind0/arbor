FROM acme/golang:1.23.5

# Common labels
LABEL image.name="worker"
LABEL image.parent="golang"
LABEL image.version="1.0.0"
LABEL layer="app"
LABEL project="hierarchy-example"

# Build arguments - including platform info
ARG TARGETPLATFORM
ARG TARGETOS
ARG TARGETARCH
ARG BUILDPLATFORM

# Worker app: FROM golang (inherits the Go runtime). Builds a tiny binary.
WORKDIR /src
RUN printf 'package main\nimport("fmt";"time")\nfunc main(){for{fmt.Println("tick");time.Sleep(time.Second)}}\n' > main.go \
    && go build -o /usr/local/bin/worker main.go
CMD ["worker"]




