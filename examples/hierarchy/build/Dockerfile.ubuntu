FROM ubuntu:22.04

# Common labels
LABEL image.name="ubuntu"
LABEL image.version="22.04.0"
LABEL layer="os"
LABEL project="hierarchy-example"

# Build arguments - including platform info
ARG TARGETPLATFORM
ARG TARGETOS
ARG TARGETARCH
ARG BUILDPLATFORM

# Environment variables
ENV DEBIAN_FRONTEND=noninteractive

# Base OS layer (root of the hierarchy). Common tooling every descendant gets.
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl ca-certificates git xz-utils \
    && rm -rf /var/lib/apt/lists/*




