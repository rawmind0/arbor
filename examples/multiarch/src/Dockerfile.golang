{{ template "base" . }}

{{ define "content" }}
# Go runtime layer: FROM ubuntu. Installs Go ${GO_VERSION} for the architecture
# currently being built ($TARGETOS/$TARGETARCH are set per platform), so the
# same Dockerfile yields correct amd64 and arm64 layers.
RUN curl -fsSL "https://go.dev/dl/go${GO_VERSION}.${TARGETOS}-${TARGETARCH}.tar.gz" \
    | tar -C /usr/local -xz
ENV PATH="/usr/local/go/bin:${PATH}"
RUN go version
{{ end }}
