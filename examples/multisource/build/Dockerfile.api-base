FROM ubuntu:22.04

# Common labels
LABEL image.name="api-base"
LABEL image.version="1.0.0"
LABEL project="multisource-example"

# Build arguments - including platform info
ARG TARGETPLATFORM
ARG TARGETOS
ARG TARGETARCH
ARG BUILDPLATFORM
ARG GO_VERSION=1.23.5

# Environment variables
ENV DEBIAN_FRONTEND=noninteractive

# API stack root: install the Go ${GO_VERSION} runtime (arch-aware) that the api
# services inherit.
RUN apt-get update && apt-get install -y --no-install-recommends curl ca-certificates \
    && curl -fsSL "https://go.dev/dl/go${GO_VERSION}.${TARGETOS}-${TARGETARCH}.tar.gz" \
       | tar -C /usr/local -xz \
    && rm -rf /var/lib/apt/lists/*
ENV PATH="/usr/local/go/bin:${PATH}"




