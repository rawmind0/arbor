{{ template "base" . }}

{{ define "content" }}
# Background worker: FROM api-base (inherits the Go runtime).
WORKDIR /src
RUN printf 'package main\nimport("fmt";"time")\nfunc main(){for{fmt.Println("job");time.Sleep(time.Second)}}\n' > main.go \
    && go build -o /usr/local/bin/worker main.go
CMD ["worker"]
{{ end }}
