FROM alpine:3.18

# Common labels
LABEL image.name="base"
LABEL image.version="1.0.0"
LABEL layer="base"
LABEL project="minimal-example"

# Build arguments - including platform info
ARG TARGETPLATFORM
ARG TARGETOS
ARG TARGETARCH
ARG BUILDPLATFORM

# Base layer: shared runtime deps every child inherits.
RUN apk add --no-cache ca-certificates tini
ENTRYPOINT ["/sbin/tini", "--"]




