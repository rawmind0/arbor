#!/bin/bash
# Build commands generated by arbor
# Generated: {{rfc3339 .Metadata.Generated}}
{{if .Login}}
# Registry login (credentials from REGISTRY_USERNAME / REGISTRY_PASSWORD)
{{- range .Login}}
{{shell .}}
{{- end}}
{{end}}
{{- range $q := .Queues}}
{{- if gt (len $.Queues) 1}}
# Queue: {{$q.ID}}
{{- end}}
{{- range $bi, $b := $q.Batches}}
# Batch {{add $bi 1}} - tasks can run in parallel
{{- range $b.Tasks}}
{{- with commandFor $q .}}
echo "Building {{.ImageTag}}"
{{- range .Steps}}
{{shell .}}
{{- else}}
{{shell .Command}}
{{- end}}
{{end}}
{{- end}}
{{- if lt $bi (sub (len $q.Batches) 1)}}
# Wait for batch to complete before proceeding to next batch
wait
{{end}}
{{- end}}
{{- end}}
