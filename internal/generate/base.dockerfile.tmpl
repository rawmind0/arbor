FROM {{ .FROM }}

{{- with .Labels }}

# Common labels
  {{- range $key, $value := . }}
LABEL {{ $key }}="{{ $value }}"
  {{- end }}
{{- end }}

# Build arguments - including platform info
ARG TARGETPLATFORM
ARG TARGETOS
ARG TARGETARCH
ARG BUILDPLATFORM
{{- range $key, $value := .Args }}
ARG {{ $key }}={{ $value }}
{{- end }}

{{- with .Envs }}

# Environment variables
  {{- range $key, $value := . }}
ENV {{ $key }}={{ $value }}
  {{- end }}
{{- end }}
{{ template "content" . }}
